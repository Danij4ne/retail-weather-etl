# Local Docker Compose defaults for development/demo only.
# In real deployments, inject sensitive variables from the runtime/orchestrator
# instead of relying on a project-level .env file on the server.

# Unix user id the Airflow containers run as, so mounted volumes stay writable
# from both sides. `make env-init` fills it in with your own `id -u`; 50000 is
# the airflow user inside the image and only acts as a fallback.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_TAG=local
# Airflow DAG weather mode: false reuses the existing RAW weather CSV; true refreshes it from the API.
RETAIL_ETL_FETCH_WEATHER=false

# Sensitive / local-only defaults: change before running in any shared environment.
# Airflow admin user created by airflow-init. Compose fails if the password is unset.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=your-email@example.com
AIRFLOW_ADMIN_PASSWORD=change_me

# Metadata database used by Airflow (not published to the host).
# Avoid @ : / # in POSTGRES_PASSWORD; they break the SQLAlchemy URL.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=airflow

# Optional runtime alerts for critical pipeline failures.
ALERTS_ENABLED=false
ALERTS_CHANNEL=slack
ALERTS_ENVIRONMENT=local
ALERTS_PROJECT=retail-weather-etl
ALERTS_TIMEOUT_SECONDS=5
# Example: https://hooks.slack.com/services/replace/me
ALERTS_SLACK_WEBHOOK_URL=